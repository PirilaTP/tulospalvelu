msgstr "Option 'T)otal times' prints only the total times."

#: JukConsole/lasktxt.cpp
msgid "Valinta 'K)aikki' tulostaa sekä yhteisajat että kaikkien"
msgstr "Option 'A)ll' prints both the total times and all"

