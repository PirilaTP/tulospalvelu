#: JukConsole/lasktxt.cpp
msgid "Sivu 3 :   SIIRTYMINEN KENTÄSTÄ TOISEEN, OSUUDEN VAIHTO"
msgstr "Sida 3 :   FÖRFLYTTNING MELLAN FÄLT, BYTE AV STRÄCKA"

#: JukConsole/lasktxt.cpp
msgid "Sivu 4 :   TIETOJEN SYÖTTÖ JA MUUTTAMINEN"
msgstr "Sida 4 :   INMATNING OCH ÄNDRING AV DATA"

#: JukConsole/lasktxt.cpp
msgid "Sivu 5 :   YHTEISLÄHTÖ"
msgstr "Sida 5 :   MASSTART"

#: JukConsole/lasktxt.cpp
msgid "Sivu 6 :   TIEDONSIIRTO"
msgstr "Sida 6 :   DATAÖVERFÖRING"

#: JukConsole/lasktxt.cpp
msgid "Sivu 7 :   KÄYTTÖ MAALIKELLONA"
msgstr "Sida 7 :   ANVÄNDNING SOM MÅLKLOCKA"

#: JukConsole/lasktxt.cpp
msgid "Sivu 8 :   KÄYTTÖ MAALIKELLONA, TOIMINTO 'MAALI'"
msgstr "Sida 8 :   ANVÄNDNING SOM MÅLKLOCKA, FUNKTIONEN 'MÅL'"

#: JukConsole/lasktxt.cpp
msgid "Sivu 9 :   TOIMINTO 'MAALI', HAKUTOIMINNOT"
msgstr "Sida 9 :   FUNKTIONEN 'MÅL', SÖKFUNKTIONER"

#: JukConsole/lasktxt.cpp
msgid "Kilpailija valitaan normaalisti antamalla kilpaijanumero."
msgstr "Den tävlande väljs normalt genom att ange startnumret."

#: JukConsole/lasktxt.cpp
msgid "siirrytään nimihakuun. Nimihaussa annetaan seuranimen alkuosa,"
msgstr "övergår man till namnsökning. Ange början av klubbnamnet,"

#: JukConsole/lasktxt.cpp
msgid "taessa näppäimillä 'S' ja 'E'. Saman seuran joukkueet tulevat"
msgstr "att bläddra med 'N' och 'F'. Samma klubbs lag visas på"

#: JukConsole/lasktxt.cpp
msgid "ruudulle sarjoittain numerojärjestyksessä."
msgstr "skärmen klassvis i nummerordning."

#: JukConsole/lasktxt.cpp
msgid "Lopuksi painetaan 'H' tai <Return>."
msgstr "Tryck till sist 'G' eller <Return>."

#: JukConsole/lasktxt.cpp
msgid "HELP,    sivu 3"
msgstr "HJÄLP,   sida 3"

#: JukConsole/lasktxt.cpp
msgid "SIIRTYMINEN KENTÄSTÄ TOISEEN JA TARKASTELTAVAN OSUUDEN VAIHTO"
msgstr "FÖRFLYTTNING MELLAN FÄLT OCH BYTE AV GRANSKAD STRÄCKA"

#: JukConsole/lasktxt.cpp
msgid "-  <Return>, '\x19' ja <F9> : Siirry seuraavaan kenttään"
msgstr "-  <Return>, '\x19', <F9>   : Gå till nästa fält"

#: JukConsole/lasktxt.cpp
msgid "-  '\x18' ja <F5>           : Siirry edelliseen kenttään"
msgstr "-  '\x18' och <F5>          : Gå till föregående fält"

#: JukConsole/lasktxt.cpp
msgid "-  PgDn ja <F10>         : Seuraava osuus"
msgstr "-  PgDn och <F10>        : Nästa sträcka"

#: JukConsole/lasktxt.cpp
msgid "-  PgUp ja <F6>          : Edellinen osuus"
msgstr "-  PgUp och <F6>         : Föregående sträcka"

#: JukConsole/lasktxt.cpp
msgid "-  <Tab>                 : Oikealle osuusalueella"
msgstr "-  <Tab>                 : Åt höger i sträckområdet"

#: JukConsole/lasktxt.cpp
msgid "-  <Shift-Tab>           : Vasemmalle osuusalueella"
msgstr "-  <Shift-Tab>           : Åt vänster i sträckområdet"

#: JukConsole/lasktxt.cpp
msgid "-  '+'                   : Poistu ruudusta TALLENTAEN tiedot"
msgstr "-  '+'                   : Lämna skärmen och SPARA uppgifterna"

#: JukConsole/lasktxt.cpp
msgid "-  <Esc>                 : Poistu ruudusta TALLENTAMATTA"
msgstr "-  <Esc>                 : Lämna skärmen UTAN att spara"

#: JukConsole/lasktxt.cpp
msgid "tehtyjä muutoksia"
msgstr "gjorda ändringar"

#: JukConsole/lasktxt.cpp
msgid "HELP,    sivu 4     TIETOJEN SYÖTTÖ JA MUUTTAMINEN"
msgstr "HJÄLP,   sida 4     INMATNING OCH ÄNDRING AV DATA"

#: JukConsole/lasktxt.cpp
msgid "Aikoja ja kilpailunumeroa korjattaessa käytetään numeronäppäi-"
msgstr "Vid ändring av tider och startnummer används sifferknappar-"

#: JukConsole/lasktxt.cpp
msgid "miä, nuolia '\x1b' ja '\x1a' sekä näppäimä <Home> ja <End>. Korjaus"
msgstr "na, pilarna '\x1b' och '\x1a' samt tangenterna <Home> och <End>."

#: JukConsole/lasktxt.cpp
msgid "tapahtuu korvaustoimintana (Replace). Nuolien sijasta voidaan"
msgstr "Ändringen sker i ersättningsläge (Replace). I stället för"

#: JukConsole/lasktxt.cpp
msgid "aina käyttää näppäimiä <F7> ja <F8>"
msgstr "pilarna kan alltid tangenterna <F7> och <F8> användas"

#: JukConsole/lasktxt.cpp
msgid "Muita tietoja korjattaessa voidaan käyttää lisäys (Insert) tai"
msgstr "Andra uppgifter kan ändras i infogningsläge (Insert) eller"

#: JukConsole/lasktxt.cpp
msgid "korvaustoimintaa; toiminta vaihdetaan näppäimellä <Ins>"
msgstr "ersättningsläge; läget växlas med tangenten <Ins>"

#: JukConsole/lasktxt.cpp
msgid "Kentän loppuosan poistaa yhdistelmä <Ctrl-End>"
msgstr "Resten av fältet raderas med kombinationen <Ctrl-End>"

#: JukConsole/lasktxt.cpp
msgid "Käytettävissä on myös näppäimet \x1b, \x1a F7, F8, Del, Askelpal."
msgstr "Även tangenterna \x1b, \x1a F7, F8, Del, Backsteg kan användas."

#: JukConsole/lasktxt.cpp
msgid "Poista tulos merkitsemällä maaliajaksi välilyöntejä."
msgstr "Radera ett resultat genom att ange blanksteg som måltid."

#: JukConsole/lasktxt.cpp
msgid "HELP,    sivu 5     YHTEISLÄHTÖ"
msgstr "HJÄLP,   sida 5     MASSTART"

#: JukConsole/lasktxt.cpp
msgid "Yhteislähtöön osallistuminen voidaan kirjata:"
msgstr "Deltagande i masstart kan registreras:"

#: JukConsole/lasktxt.cpp
msgid "Automaattisesti käyttäen toimintoa A)setukset/L)ähdöt."
msgstr "Automatiskt med funktionen I)nställningar/S)tarter."

#: JukConsole/lasktxt.cpp
msgid "Korjaustoiminnossa kirjoittamalla osuustietoalueella ensimmäisen"
msgstr "I korrigeringsfunktionen genom att i sträckområdet för lagets"

#: JukConsole/lasktxt.cpp
msgid "    kyseisestä joukkueesta yhteislähtöön osallistuvan osuuden"
msgstr "    första sträcka som deltar i masstarten skriva"

#: JukConsole/lasktxt.cpp
msgid "    kohdalle viimeiseen sarakkeeseen (sarake Y) kirjain 'Y'."
msgstr "    bokstaven 'Y' i sista kolumnen (kolumn Y)."

#: JukConsole/lasktxt.cpp
msgid "Laskentatoiminnossa lopettamalla ajan syöttö painallukseen 'Y'"
msgstr "I beräkningsfunktionen genom att avsluta tidsinmatningen med 'Y'"

#: JukConsole/lasktxt.cpp
msgid "    Tämä voidaan tehdä syötettäessä yhteislähtöön osallistuvaa"
msgstr "    Detta kan göras vid inmatning för den tävlande som deltar"

#: JukConsole/lasktxt.cpp
msgid "    tai edellistä kilpailijaa"
msgstr "    i masstarten eller för den föregående"

#: JukConsole/lasktxt.cpp
msgid "Jos yhteislähtömerkintä tehdään viimeistä osuutta aiemmalle"
msgstr "Om masstartsmarkeringen görs för en tidigare än sista sträckan,"

#: JukConsole/lasktxt.cpp
msgid "osuudelle, merkitään kaikki loput osuudet yhteislähtöön osal-"
msgstr "markeras alla återstående sträckor som deltagande i masstart,"

#: JukConsole/lasktxt.cpp
msgid "listuviksi, ellei tätä ole muutettu valinnassa A)setukset/L)ähdöt"
msgstr "om inte detta ändrats i valet I)nställningar/S)tarter"

#: JukConsole/lasktxt.cpp
msgid "Tarkasteltaessa yhteislähtöön osallistuvaa osuutta näkyy kuva-"
msgstr "Vid granskning av en sträcka som deltar i masstart visas"

#: JukConsole/lasktxt.cpp
msgid "ruudulla yhteislähdön aika, joka annetaan ensimmäistä yhteis-"
msgstr "masstartens tid, som anges när den första masstarts-"

#: JukConsole/lasktxt.cpp
msgid "lähtömerkintää tehtäessä.  Aika voidaan vaihtaa, jos yhteislähtö"
msgstr "markeringen görs.  Tiden kan ändras om masstarten flyttas"

#: JukConsole/lasktxt.cpp
msgid "siirtyy tai yhteislähtöjä on useampia. Muutos voidaa tehdä auto-"
msgstr "eller om det finns flera masstarter. Ändringen kan göras"

#: JukConsole/lasktxt.cpp
msgid "maattisesti tai erikseen jokaiselle yhteislähtöön osallistuvalle."
msgstr "automatiskt eller separat för varje deltagare i masstarten."

#: JukConsole/lasktxt.cpp
msgid "HELP,    sivu 6      TIEDONSIIRTO"
msgstr "HJÄLP,   sida 6      DATAÖVERFÖRING"

#: JukConsole/lasktxt.cpp
msgid "HELP,    sivu 7     KÄYTTÖ MAALIKELLONA"
msgstr "HJÄLP,   sida 7     ANVÄNDNING SOM MÅLKLOCKA"

#: JukConsole/lasktxt.cpp
msgid "jota ei yleensä kannata muuttaa sekä ajanottoon käytettävää,"
msgstr "som vanligen inte bör ändras, samt efter tangenten som används"

#: JukConsole/lasktxt.cpp
msgid "TOIMINNON 'MAALI' OHJEET SIVULLA 8"
msgstr "INSTRUKTIONER FÖR FUNKTIONEN 'MÅL' PÅ SIDA 8"

#: JukConsole/lasktxt.cpp
msgid "HELP,    sivu 8      KÄYTTÖ MAALIKELLONA, TOIMINTO 'MAALI'"
msgstr "HJÄLP,   sida 8      MÅLKLOCKA, FUNKTIONEN 'MÅL'"

#: JukConsole/lasktxt.cpp
msgid "  Aikojen tallentaminen muistiin: kts. help-sivu 7. Toiminnossa"
msgstr "  Sparande av tider i minnet: se hjälpsida 7. I funktionen"

#: JukConsole/lasktxt.cpp
msgid "'Maali' voidaan aikoihin liittää kätevästi kilpailijan numero ja"
msgstr "'Mål' kan tiderna smidigt kopplas till tävlandes nummer och"

#: JukConsole/lasktxt.cpp
msgid "suorittaa erilaisia ajanottoon liittyviä korjaustoimia. Toimet"
msgstr "olika korrigeringar i samband med tidtagningen göras. De"

#: JukConsole/lasktxt.cpp
msgid "tapahtuvat korostetulle riville, jota voidaan vaihtaa näppäi-"
msgstr "gäller den markerade raden, som kan bytas med tangenterna"

#: JukConsole/lasktxt.cpp
msgid "millä \x18, \x19, F5, F9, PgUp, PgDn, Ctrl-PgUp ja Ctrl-PgDn."
msgstr "\x18, \x19, F5, F9, PgUp, PgDn, Ctrl-PgUp och Ctrl-PgDn."

#: JukConsole/lasktxt.cpp
msgid "  Näppäinyhdistelmä Alt-S tuo sijoituksen näytölle, Alt-E vaihtaa"
msgstr "  Tangentkombinationen Alt-S visar placeringen, Alt-E växlar"

#: JukConsole/lasktxt.cpp
msgid "aikanäyttöä, Alt-N tuo näytölle joukkueen kaikki tiedot"
msgstr "tidsvisningen, Alt-N visar alla lagets uppgifter"

#: JukConsole/lasktxt.cpp
msgid "HELP,    sivu 9      TOIMINTO 'MAALI', HAKUTOIMINNOT"
msgstr "HJÄLP,   sida 9      FUNKTIONEN 'MÅL', SÖKFUNKTIONER"

#: JukConsole/lasktxt.cpp
msgid "  Alt-R    Siirry riville, jonka järjestysnumero annetaan"
msgstr "  Alt-R    Gå till raden vars löpnummer anges"

#: JukConsole/lasktxt.cpp
msgid "  Alt-H    Hae seuraava rivi, jolla annettava joukkueen numero"
msgstr "  Alt-H    Sök nästa rad med angivet lagnummer"

#: JukConsole/lasktxt.cpp
msgid "  ALT-G    Toista haku samalle joukkueen numerolle."
msgstr "  ALT-G    Upprepa sökningen för samma lagnummer."

#: JukConsole/lasktxt.cpp
msgid "  Alt-0 (nolla) Hae seuraava rivi, jolla ei numeroa."
msgstr "  Alt-0 (noll) Sök nästa rad utan nummer."

#: JukConsole/lasktxt.cpp
msgid "  Alt-X    Hae rivi, jolla epäilyttävä tieto (merkitty '*')"
msgstr "  Alt-X    Sök rad med misstänkt uppgift (markerad '*')"

#: JukConsole/lasktxt.cpp
msgid "Kun viimeinen rivi on saavutettu, jatkuvat edellä luetellut"
msgstr "När sista raden har nåtts fortsätter ovanstående"

#: JukConsole/lasktxt.cpp
msgid "haut enismmäiseltä riviltä."
msgstr "sökningar från första raden."

#: JukConsole/lasktxt.cpp
msgid "Valitse toiminto painamalla alkukirjainta"
msgstr "Välj funktion genom att trycka på dess bokstav"

#: JukConsole/lasktxt.cpp
msgid "L)askenta       Tulosten, hylkäysten ym. syöttö ja korjaukset"
msgstr "B)eräkning      Inmatning och ändring av resultat, disk m.m."

#: JukConsole/lasktxt.cpp
msgid "tulostuksen käynnistys. 'O': oikaise valintoja"
msgstr "automatisk utskrift. 'O': hoppa över val"

#: JukConsole/lasktxt.cpp
msgid "A)setukset      Muuta ohjelman asetuksia, mm. yhteislähtö "
msgstr "I)nställningar  Ändra programmets inställningar, bl.a. masstart "

#: JukConsole/lasktxt.cpp
msgid "lE)eimat        Leimantarkastusnäyttö ja -toiminnot"
msgstr "S)tämplingar    Stämplingskontrollskärm och -funktioner"

#: JukConsole/lasktxt.cpp
msgid "T)arrojen tulostus Keskeytä/muuta kaikki/ei-lähteneet"
msgstr "E)tikettutskrift   Avbryt/ändra alla/ej startade"

#: JukConsole/lasktxt.cpp
msgid "A)jat              Kellon käynti, aikojen tarkkuus, maalikello"
msgstr "T)ider             Klockans gång, tidsprecision, målklocka"

#: JukConsole/lasktxt.cpp
msgid "V)aroituskynnykset Muuta osuuskohtaisia minimiaikoja"
msgstr "V)arningsgränser   Ändra sträckvisa minimitider"

#: JukConsole/lasktxt.cpp
msgid "L)ähdöt            Muuta lähtöaikoja. Käynnistä tai keskeytä"
msgstr "S)tarter           Ändra starttider. Starta eller avbryt"

#: JukConsole/lasktxt.cpp
msgid "yhteislähtöjen automaattinen kirjaus"
msgstr "automatisk registrering av masstarter"

#: JukConsole/lasktxt.cpp
msgid "M)odemi            Lähetä sanomia modemille tiedonsiirron "
msgstr "M)odem             Sänd meddelanden till modemet för att "

#: JukConsole/lasktxt.cpp
msgid "käynnistämiseksi tai keskeyttämiseksi"
msgstr "starta eller avbryta dataöverföring"

#: JukConsole/lasktxt.cpp
msgid "loK)i              Muuta lokin tulostusta"
msgstr "L)ogg              Ändra loggens utskrift"

#: JukConsole/lasktxt.cpp
msgid "Yhteislähtöjen automaattinen kirjaus soveltuu käytettäväksi"
msgstr "Automatisk registrering av masstarter kan användas,"

#: JukConsole/lasktxt.cpp
msgid "jos kaikkien sarjojen ja osuuksien vaihdot suljetaan saman-"
msgstr "om växlingen stängs samtidigt för alla klasser och"

#: JukConsole/lasktxt.cpp
msgid "aikaisesti ja kaikkien sarjojen ja osuuksien yhteislähdöt"
msgstr "sträckor och masstarterna för alla klasser och sträckor"

#: JukConsole/lasktxt.cpp
msgid "ovat yhtäaikaiset."
msgstr "sker samtidigt."

#: JukConsole/lasktxt.cpp
msgid "Ohjelma kysyy ensin yhteislähdön ja vaihdon sulkemisen ajat"
msgstr "Programmet frågar först tiderna för masstart och stängning"

#: JukConsole/lasktxt.cpp
msgid "ja käynnistää sitten vahvistuksen saatuaan yhteislähtöjen"
msgstr "av växlingen och startar sedan efter bekräftelse den"

#: JukConsole/lasktxt.cpp
msgid "automaattisen kirjauksen."
msgstr "automatiska registreringen av masstarter."

#: JukConsole/lasktxt.cpp
msgid "Yhteislähtömerkinnät tehdään kirjattaessa vaihdon sulkemisen"
msgstr "Masstartsmarkeringar görs när växlingstider efter växlingens"

#: JukConsole/lasktxt.cpp
msgid "jälkeisiä vaihtoaikoja - jo kirjattujen vaihtojen osalta heti"
msgstr "stängning registreras - för redan registrerade växlingar"

#: JukConsole/lasktxt.cpp
msgid "vahvistuksen jälkeen. Kirjausta jatketaan kunnes automaattinen"
msgstr "direkt efter bekräftelsen. Registreringen fortsätter tills"

#: JukConsole/lasktxt.cpp
msgid "kirjaus keskeytetään tässä samassa valikossa."
msgstr "den automatiska registreringen avbryts i samma meny."

#: JukConsole/lasktxt.cpp
msgid "Ilmoitettujen sulkemis- ja lähtöaikojen muutos johtaa kaikkien"
msgstr "Ändring av angivna stängnings- och starttider leder till att"

#: JukConsole/lasktxt.cpp
msgid "yhteislähtömerkintöjen korjaamisen muutettujen aikojen mukaan."
msgstr "alla masstartsmarkeringar korrigeras enligt de nya tiderna."

#: JukConsole/lasktxt.cpp
msgid "L)isää           : Lisää kilpailijoita. Tuloksia ei voi antaa"
msgstr "L)ägg till       : Lägg till tävlande. Resultat kan inte anges"

#: JukConsole/lasktxt.cpp
msgid "K)orjaa          : Korjaa kilpailijatietoja tai tuloksia"
msgstr "R)ätta           : Ändra tävlandes uppgifter eller resultat"

#: JukConsole/lasktxt.cpp
msgid "P)oista          : Poista kilpailija. Poistoa ei voi tehdä, jos"
msgstr "T)a bort         : Ta bort tävlande. Ej möjligt, om"

#: JukConsole/lasktxt.cpp
msgid "J)uoksujärjestys : Syötä juoksujärjestyksiä"
msgstr "K)örordning      : Mata in körordningar"

#: JukConsole/lasktxt.cpp
msgid ".. T)iedostosta  : Lue juoksujärjestyksiä tiedostosta, joka"
msgstr ".. F)rån fil     : Läs körordningar från en fil som"

#: JukConsole/lasktxt.cpp
msgid "on saatu esim. sähköpostina"
msgstr "t.ex. har tagits emot per e-post"

#: JukConsole/lasktxt.cpp
msgid "H)yväksytyt       Hyväksytyt"
msgstr "G)odkända         Godkända"

#: JukConsole/lasktxt.cpp
msgid "hY)lätyt          Hylätyt"
msgstr "D)iskade          Diskvalificerade"

#: JukConsole/lasktxt.cpp
msgid "E)i lähteneet     Ei lähteneiksi merkityt"
msgstr "E)j startade      Markerade som ej startade"

#: JukConsole/lasktxt.cpp
msgid "A)voimet          Vailla tulosta olevat"
msgstr "öP)pna            Utan resultat"

#: JukConsole/lasktxt.cpp
msgid "V)alitut          Seura-, piiri, ja ratatulosten laadinta"
msgstr "V)alda            Klubb-, distrikts- och banresultat"

#: JukConsole/lasktxt.cpp
msgid "Paperille tulostettaessa aloittaa uusi seura aina uuden sivun"
msgstr "Vid utskrift på papper börjar en ny klubb alltid på ny sida"

#: JukConsole/lasktxt.cpp
