#: JukConsole/lasktxt.cpp
msgid "sarja. Uusi sarja-alue voidaan ilmoitta heti edellisen jälkeen."
msgstr "A new class range can be given right after the previous one."

#: JukConsole/lasktxt.cpp
msgid "Toiminnolla 'Backup' luodaan levykkeelle uusi kopio kilpailun"
msgstr "The 'Backup' function creates a new diskette copy of the"

#: JukConsole/lasktxt.cpp
